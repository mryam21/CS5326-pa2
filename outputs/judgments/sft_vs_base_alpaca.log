    query: 'reviews',
    variables: { id },
  });

  if (loading) return <p>Loading...</p>;
  if (error) return <p>Error</p>;

  return (
    <>
      <h2>{data.reviews[id].title}</h2>
      <p>{data.reviews[id].body}</p>
    </>
  );
};

export default function App() {
