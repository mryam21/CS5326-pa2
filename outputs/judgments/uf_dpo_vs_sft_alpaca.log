```python
# Define initial values
initial_cost_1 = 2000
monthly_savings_1 = 1000
monthly_loss_rate_1 = 0.015

initial_cost_2 = 8000
monthly_savings_2 = 1000
monthly_loss_rate_2 = 0.005

# Calculate future values for the first car
future_value_1 = initial_cost_1 * (1 - (1 + monthly_loss_rate_1)**(-n_months))

# Calculate future values for the second car
future_value_2 = initial_cost_2 * (1 - (1 + monthly_loss_rate_2)**(-n_months))

# Determine the number of months needed to save up enough money
